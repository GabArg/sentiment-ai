# Copy this file to .streamlit/secrets.toml for local use.
# Never commit the real secrets.toml file.
CEREBRAS_API_KEY = "replace-with-your-cerebras-api-key"
ENABLE_HYBRID_SENTIMENT = false
HYBRID_THRESHOLD_NEGATIVE = 0.80
HYBRID_THRESHOLD_NEUTRAL = 0.65
HYBRID_THRESHOLD_POSITIVE = 0.60
HYBRID_MAX_REVIEWS_PER_BATCH = 25
